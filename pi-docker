#!/usr/bin/env bash
set -euo pipefail

IMAGE_NAME="pi-sandbox"

# Prefer the rootless daemon when one is running. Under rootless, container
# root maps to the invoking user through a user namespace, so --privileged and
# host bind mounts cannot exceed the user's own permissions. Set DOCKER_HOST
# yourself, or pass --rootful, to opt out.
ROOTLESS_SOCK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/docker.sock"
PI_CONFIG_DIR="${HOME}/.pi/agent"
PI_EXTENSIONS_DIR="${PI_EXTENSIONS_DIR:-${HOME}/pi-extensions}"
PI_SKILLS_DIR="${PI_SKILLS_DIR:-${PI_CONFIG_DIR}/skills}"
PI_LIFEOS_CONFIG_FILE="${PI_LIFEOS_CONFIG_FILE:-${PI_CONFIG_DIR}/pi-lifeos.json}"
# USER subdirectories masked with an empty directory unless --with-private
# is passed. Nothing in the container reads them: the adapter never does, and
# the skills that name these paths resolve them under ~/.claude, which has no
# counterpart here. MEMORY/OBSERVABILITY is the bulk of the tree and holds a
# running log of every tool call, so it is the one most worth withholding.
PI_LIFEOS_PRIVATE_DIRS="${PI_LIFEOS_PRIVATE_DIRS:-FINANCES HEALTH MEMORY/OBSERVABILITY MEMORY/SECURITY MEMORY/UPGRADES MEMORY/VOICE}"

usage() {
    cat <<'USAGE'
Usage: pi-docker [OPTIONS] [extra-path ...]

Run the PI coding agent in a sandboxed Docker container.

Options:
  --login       Start in OAuth login mode (uses --network host, no security)
  --local       Use host network for local LLM access (keeps security hardening)
  --build       Build the Docker image before running
  --tools LIST  Mount host tools into container (comma-separated, e.g. python,ghdl)
  --host-apps   Bind-mount host /usr/{bin,lib,lib64,lib32,libexec,sbin,share,include}
                read-only into the container so every host-installed application
                works natively. Implies read access to all of host /usr (except
                /usr/local and /usr/src). Writes stay confined to /workspace,
                /home/pi/.pi/, and /tmp. Supersedes --tools.
  --unrestricted
                Remove Docker sandbox restrictions and run PI with host-like
                access: host UID/GID, host network, writable host filesystem
                mounts at their normal paths, and host root at /host. Supersedes
                --tools and --host-apps.
  --no-sandbox  Alias for --unrestricted
  --lifeos-write
                Mount the LifeOS personal data root read-write and open the
                adapter's memory-mutation gate. The package, runtime and skills
                roots stay read-only. Approved changes are still applied only
                through the adapter's proposal review.
  --fpga        Start a per-session job broker so the session can run FPGA
                toolchain jobs with fpga-run (see broker/README.md). The
                Docker socket is never mounted: the broker runs only the
                launchers configured in PI_BROKER_CONFIG, in directories this
                session has mounted.
  --rootful     Use the root Docker daemon even when a rootless one is running.
                Without this, a rootless daemon is preferred automatically.
  --with-private
                Expose the LifeOS USER subdirectories masked by default.
                Pass this only for a session that genuinely needs them.
  --git         Let the session use git as you: forwards the host SSH agent and
                your git identity, so it can clone, pull, commit and push over
                SSH. The private key itself never enters the container. Off by
                default; requires a running SSH agent.
  --gh          Additionally expose a GitHub API token (PI_GH_TOKEN, else the
                gh CLI's) for pull requests and issues. Separate from --git
                because a token is readable inside the container, unlike the
                forwarded agent. Prefer a fine-grained, repo-scoped token.
  --help        Show this help message

Arguments:
  extra-path    Additional host directories to mount under /repos/<basename>
                (or at the same absolute path with --unrestricted)

Environment:
  PI_EXTENSIONS_DIR   Extensions directory (default: ~/pi-extensions)
  PI_SKILLS_DIR       Skills directory (default: ~/.pi/agent/skills). A symlink is
                      resolved host-side, so the real tree lands in the container.
  PI_LIFEOS_CONFIG_FILE
                      LifeOS adapter config (default: ~/.pi/agent/pi-lifeos.json).
                      When present, package/runtime/skills/USER paths are mounted
                      read-only at their host absolute paths automatically.
  PI_LIFEOS_PRIVATE_DIRS
                      Space-separated USER subdirectories masked unless
                      --with-private is given (default: FINANCES HEALTH).

Examples:
  pi-docker                           # Run in current directory
  pi-docker ~/other-repo              # Mount extra repo under /repos/other-repo
  pi-docker --login                   # OAuth login to Anthropic, etc.
  pi-docker --build                   # Rebuild image, then run
  pi-docker --tools python,ghdl       # Run with host tools mounted
  pi-docker --local                   # Use host network for local LLMs
  pi-docker --local --tools python    # Combine local LLM + host tools
  pi-docker --host-apps               # Full host app access (write-jail mode)
  pi-docker --host-apps --local       # Host apps + local LLMs
  pi-docker --unrestricted            # Host-like access, no Docker sandboxing
USAGE
    exit 0
}

# Is the given SONAME a glibc-family library? These must NOT be exposed to
# kernel-exec'd child processes via LD_LIBRARY_PATH — mixing host glibc with
# the container's dynamic linker causes GLIBC_PRIVATE symbol crashes. The
# wrapper still reaches them through --library-path /opt/host-tools/host-usr/lib.
is_glibc_lib() {
    case "$1" in
        libc.so.*|libm.so.*|libpthread.so.*|libdl.so.*|librt.so.*) return 0 ;;
        libresolv.so.*|libnsl.so.*|libutil.so.*|libcrypt.so.*) return 0 ;;
        libBrokenLocale.so.*|libanl.so.*|libthread_db.so.*) return 0 ;;
        # ld-linux is intentionally NOT excluded: entrypoint.sh looks for it
        # at /opt/host-tools/lib/ld-linux-*.so.* to generate tool wrappers.
        # It's safe in LD_LIBRARY_PATH — kernel picks the linker from
        # PT_INTERP, not from LD_LIBRARY_PATH.
        *) return 1 ;;
    esac
}

# Is the given path a standard system library directory? Mounting these would
# overlay the container's own libs (libc, libstdc++) and break the container.
is_system_lib_dir() {
    case "$1" in
        /lib|/lib64|/lib32|/usr/lib|/usr/lib64|/usr/lib32) return 0 ;;
        /lib/x86_64-linux-gnu|/usr/lib/x86_64-linux-gnu) return 0 ;;
        /lib/aarch64-linux-gnu|/usr/lib/aarch64-linux-gnu) return 0 ;;
        *) return 1 ;;
    esac
}

# Extract RPATH/RUNPATH entries from an ELF binary (one dir per line).
# Expands $ORIGIN to the binary's directory. Skips nonexistent paths.
# Silently returns nothing if readelf is unavailable.
collect_elf_rpaths() {
    local bin="$1"
    command -v readelf >/dev/null 2>&1 || return 0
    local bin_dir rpath_lines
    bin_dir="$(dirname "$bin")"
    # Capture first so a no-match grep can't trip pipefail in the caller.
    rpath_lines="$(readelf -d "$bin" 2>/dev/null | grep -E '\(R(UN)?PATH\)' || true)"
    [ -z "$rpath_lines" ] && return 0
    echo "$rpath_lines" | sed -E 's/.*\[([^]]*)\].*/\1/' | tr ':' '\n' | \
        while read -r p; do
            [ -z "$p" ] && continue
            p="${p//\$ORIGIN/$bin_dir}"
            p="${p//\$\{ORIGIN\}/$bin_dir}"
            [ -d "$p" ] && readlink -f "$p"
        done
    return 0
}

# Collect shared library info for an ELF binary.
# Emits "NEEDED|RESOLVED" pairs — NEEDED is the DT_NEEDED/SONAME-style name the
# dynamic linker searches for (e.g. libfreetype.so.6); RESOLVED is the real file
# on disk (e.g. /usr/lib/libfreetype.so.6.20.6). Callers mount RESOLVED at a
# path named NEEDED so the linker finds it via LD_LIBRARY_PATH/RPATH search.
# Skips virtual libraries (vdso, linux-gate).
collect_elf_libs() {
    local elf_path="$1"
    ldd "$elf_path" 2>/dev/null | while read -r line; do
        case "$line" in *linux-vdso*|*linux-gate*) continue ;; esac
        local needed="" lib_path=""
        if echo "$line" | grep -qE "=> /.+ \(0x"; then
            needed="$(echo "$line" | awk '{print $1}')"
            # Some ldd lines print absolute-path NEEDED (ld-linux); basename them.
            case "$needed" in /*) needed="$(basename "$needed")" ;; esac
            lib_path="$(echo "$line" | sed -E 's/.*=> (\/[^ ]+) \(0x.*/\1/')"
        elif echo "$line" | grep -qE "^\s*/"; then
            lib_path="$(echo "$line" | sed -E 's/^\s*(\/[^ ]+).*/\1/')"
            needed="$(basename "$lib_path")"
        fi
        if [ -n "$lib_path" ] && [ -f "$lib_path" ]; then
            echo "${needed}|$(readlink -f "$lib_path")"
        fi
    done
}

# Detect runtime directories a tool needs beyond its binary and .so deps.
# Output: one "DIR:<path>" line per directory to mount at its original path.
detect_runtime_dirs() {
    local real_path="$1"
    local libs="$2"
    # Python: if it links libpythonX.Y, mount the stdlib directory
    local pyver
    pyver="$(echo "$libs" | grep -oP 'libpython\K[0-9]+\.[0-9]+' | head -1)" || true
    if [ -n "$pyver" ]; then
        local pylib="/usr/lib/python${pyver}"
        [ -d "$pylib" ] && echo "DIR:${pylib}"
        local pydynload="/usr/lib/python${pyver}/lib-dynload"
        [ -d "$pydynload" ] && echo "DIR:${pydynload}"
    fi
}

# Resolve a host tool into: its real binary path, library deps, and runtime dirs.
# Output format:
#   BIN:<real_binary_path>  — the tool binary
#   LIB:<real_lib_path>     — shared library dependency
#   DIR:<dir_path>          — runtime directory to mount at original path
resolve_tool_deps() {
    local tool_name="$1"
    local binary_path

    binary_path="$(command -v "$tool_name" 2>/dev/null)" || true
    if [ -z "$binary_path" ]; then
        echo "Warning: tool '${tool_name}' not found on host, skipping" >&2
        return
    fi

    local real_path
    real_path="$(readlink -f "$binary_path")"

    if [ "$(head -c4 "$real_path" 2>/dev/null | od -An -tx1 | tr -d ' \n')" = "7f454c46" ]; then
        echo "BIN:${real_path}"
        local libs
        libs="$(collect_elf_libs "$real_path")"
        echo "$libs" | while IFS='|' read -r lib_needed lib_path; do
            [ -z "$lib_path" ] && continue
            # LIB emission carries both names: NEEDED is the dynamic-linker
            # search key (libfreetype.so.6), path is the real file.
            echo "LIB:${lib_needed}|${lib_path}"
            # If the lib lives in a tool-specific subdir (not a system-wide
            # lib dir), mount that dir at its literal path. Needed for libs
            # referenced via RPATH when the binary is exec'd by the kernel
            # without going through our wrapper (e.g. octave spawning
            # /usr/bin/octave-cli-*).
            lib_dir="$(dirname "$lib_path")"
            is_system_lib_dir "$lib_dir" || echo "DIR:${lib_dir}"
        done
        detect_runtime_dirs "$real_path" "$libs"
        # Mount RPATH/RUNPATH dirs at their literal host paths. Needed because
        # the kernel-invoked linker on execve'd children doesn't know about our
        # isolated /opt/host-tools/lib — it only consults the binary's embedded
        # RPATH, which points at host-specific subdirs like /usr/lib64/octave/*.
        collect_elf_rpaths "$real_path" | while read -r rp; do
            [ -n "$rp" ] && echo "DIR:${rp}"
        done
        # Always mount the real binary at its literal host path — when the tool
        # is a symlink (e.g. /usr/bin/octave -> octave-cli-11.1.0) internal
        # execve calls use the resolved absolute path, which wouldn't exist in
        # the container otherwise.
        echo "SIBLING:${real_path}"
        # Detect sibling binaries (same dir, shared prefix with the tool name)
        # that the tool may exec via hardcoded absolute paths.
        local bindir
        bindir="$(dirname "$binary_path")"
        for sibling in "$bindir/${tool_name}"-* "$bindir/${tool_name}"*; do
            [ -e "$sibling" ] || continue
            [ "$sibling" = "$binary_path" ] && continue
            [ "$sibling" = "$real_path" ] && continue
            echo "SIBLING:${sibling}"
        done
    else
        # Script — resolve shebang interpreter (one level only)
        echo "BIN:${real_path}"
        local shebang
        shebang="$(head -c256 "$real_path" 2>/dev/null | head -1)"
        if [[ "$shebang" == "#!"* ]]; then
            local interp
            interp="$(echo "$shebang" | sed -E 's/^#!\s*//' | awk '{print $1}')"
            # Handle /usr/bin/env by resolving the actual command
            if [ "$(basename "$interp")" = "env" ]; then
                local env_tool
                env_tool="$(echo "$shebang" | sed -E 's/^#!\s*//' | awk '{print $2}')"
                interp="$(command -v "$env_tool" 2>/dev/null)" || true
            fi
            if [ -n "$interp" ]; then
                local real_interp
                real_interp="$(readlink -f "$interp")"
                if [ "$(head -c4 "$real_interp" 2>/dev/null | od -An -tx1 | tr -d ' \n')" = "7f454c46" ]; then
                    echo "LIB:${real_interp}"
                    local libs
                    libs="$(collect_elf_libs "$real_interp")"
                    echo "$libs" | while read -r lib; do
                        [ -n "$lib" ] && echo "LIB:${lib}"
                    done
                    detect_runtime_dirs "$real_interp" "$libs"
                fi
            fi
        fi
    fi
}

# Parse flags
LOGIN_MODE=false
LOCAL_MODE=false
BUILD_FIRST=false
HOST_APPS_MODE=false
UNRESTRICTED_MODE=false
USE_ROOTFUL=false
LIFEOS_WRITE=false
WITH_PRIVATE=false
GIT_MODE=false
GH_MODE=false
FPGA_MODE=false
EXTRA_PATHS=()
PI_ARGS=()
PARSING_PI_ARGS=false
TOOLS_LIST=""

while [ $# -gt 0 ]; do
    if [ "$PARSING_PI_ARGS" = true ]; then
        PI_ARGS+=("$1")
        shift
        continue
    fi
    case "$1" in
        --login)
            LOGIN_MODE=true
            ;;
        --local)
            LOCAL_MODE=true
            ;;
        --build)
            BUILD_FIRST=true
            ;;
        --host-apps)
            HOST_APPS_MODE=true
            ;;
        --unrestricted|--no-sandbox)
            UNRESTRICTED_MODE=true
            ;;
        --rootful)
            USE_ROOTFUL=true
            ;;
        --with-private)
            WITH_PRIVATE=true
            ;;
        --lifeos-write)
            LIFEOS_WRITE=true
            ;;
        --git)
            GIT_MODE=true
            ;;
        --gh)
            GH_MODE=true
            ;;
        --fpga)
            FPGA_MODE=true
            ;;
        --tools)
            shift
            TOOLS_LIST="${1:-}"
            if [ -z "$TOOLS_LIST" ]; then
                echo "Error: --tools requires a comma-separated list of tool names"
                exit 1
            fi
            ;;
        --help)
            usage
            ;;
        --)
            PARSING_PI_ARGS=true
            ;;
        -*)
            PI_ARGS+=("$1")
            ;;
        *)
            EXTRA_PATHS+=("$1")
            ;;
    esac
    shift
done

# --unrestricted supersedes the partial host-access modes.
if [ "$UNRESTRICTED_MODE" = true ]; then
    if [ "$HOST_APPS_MODE" = true ]; then
        echo "Note: --unrestricted implies host filesystem access; ignoring --host-apps" >&2
        HOST_APPS_MODE=false
    fi
    if [ -n "$TOOLS_LIST" ]; then
        echo "Note: --unrestricted implies host filesystem access; ignoring --tools" >&2
        TOOLS_LIST=""
    fi
fi

if [ "$UNRESTRICTED_MODE" = true ] && [ "$FPGA_MODE" = true ]; then
    echo "Note: --unrestricted already reaches the host; ignoring --fpga" >&2
    FPGA_MODE=false
fi

# --host-apps supersedes --tools (it covers the same ground more broadly).
if [ "$HOST_APPS_MODE" = true ] && [ -n "$TOOLS_LIST" ]; then
    echo "Note: --host-apps implies full host /usr access; ignoring --tools" >&2
    TOOLS_LIST=""
fi

# Select the daemon before any docker call, so build and run agree.
if [ "$USE_ROOTFUL" != true ] && [ -z "${DOCKER_HOST:-}" ] && [ -S "$ROOTLESS_SOCK" ]; then
    export DOCKER_HOST="unix://${ROOTLESS_SOCK}"
fi

# Build if requested
if [ "$BUILD_FIRST" = true ]; then
    SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
    echo "Building ${IMAGE_NAME}..."
    docker build -t "${IMAGE_NAME}" "${SCRIPT_DIR}"
fi

# Ask the daemon rather than inferring from whether DOCKER_HOST was unset: the
# variable may already point at a rootless socket, and every bind mount below
# depends on knowing whether container uid 0 maps to the invoking user.
ROOTLESS_DAEMON=false
if docker info --format '{{range .SecurityOptions}}{{println .}}{{end}}' 2>/dev/null \
        | grep -qx 'name=rootless'; then
    ROOTLESS_DAEMON=true
fi

# --unrestricted on a rootful daemon is host root: --privileged plus a
# writable / means any prompt injection reaches the real filesystem.
if [ "$UNRESTRICTED_MODE" = true ] && [ -z "${DOCKER_HOST:-}" ]; then
    echo "WARNING: --unrestricted on the root daemon grants host root." >&2
    echo "         Start rootless Docker (systemctl --user start docker) to contain it." >&2
fi

# Check image exists
if ! docker image inspect "${IMAGE_NAME}" &>/dev/null; then
    echo "Error: Docker image '${IMAGE_NAME}' not found. Run with --build first."
    exit 1
fi

# Build docker run command
HOST_PWD="$(pwd)"
CONTAINER_WORKDIR="/workspace"
WORKSPACE_MOUNT="${HOST_PWD}:/workspace"

if [ "$UNRESTRICTED_MODE" = true ]; then
    CONTAINER_WORKDIR="${HOST_PWD}"
    WORKSPACE_MOUNT="${HOST_PWD}:${HOST_PWD}"
fi

DOCKER_ARGS=(
    docker run
    --rm
    -it
    --name "pi-sandbox-$$"
    -e "TERM=${TERM:-xterm-256color}"
    -w "${CONTAINER_WORKDIR}"
    -v "${WORKSPACE_MOUNT}"
)

# Mask the ssh client drop-ins. Two of the host-access modes make this directory
# resolve to host-root-owned files - --host-apps overlays /usr, which the
# systemd-shipped symlinks point into, and --unrestricted binds /etc itself -
# and a rootless user namespace has no mapping for that uid, so ssh refuses to
# read its own configuration and every SSH operation dies before authenticating.
# The container is only ever an SSH client, and /etc/ssh/ssh_config is untouched,
# so nothing here is worth the failure mode.
DOCKER_ARGS+=(--tmpfs /etc/ssh/ssh_config.d:rw,nosuid,size=64k)

# Git and GitHub credentials. Both are off by default: an agent that can push is
# an agent that can rewrite your repositories, so access is opted into per
# session rather than inherited from whatever the invoking shell happens to hold.
#
# --git forwards the SSH agent socket instead of any key file. The private key
# never enters the container, and signatures are made by the host agent only for
# the life of the session, so nothing usable survives the container. Point
# PI_SSH_AUTH_SOCK at a dedicated agent holding a single forge key to narrow the
# reachable repositories; `ssh-add -c` makes every use raise a host prompt.
#
# --gh additionally exposes an API token. Unlike the agent socket, a token is
# readable inside the container and therefore exfiltratable, so it is a separate
# opt-in and wants a fine-grained token rather than a personal one.
if [ "$GIT_MODE" = true ] || [ "$GH_MODE" = true ]; then
    GIT_IDENTITY_NAME="$(git config --get user.name 2>/dev/null || true)"
    GIT_IDENTITY_EMAIL="$(git config --get user.email 2>/dev/null || true)"

    if [ -z "$GIT_IDENTITY_NAME" ] || [ -z "$GIT_IDENTITY_EMAIL" ]; then
        echo "Error: git user.name and user.email are unset on the host, so the" >&2
        echo "       container cannot author a commit. Set them with git config --global." >&2
        exit 1
    fi

    DOCKER_ARGS+=(
        --env "GIT_AUTHOR_NAME=${GIT_IDENTITY_NAME}"
        --env "GIT_AUTHOR_EMAIL=${GIT_IDENTITY_EMAIL}"
        --env "GIT_COMMITTER_NAME=${GIT_IDENTITY_NAME}"
        --env "GIT_COMMITTER_EMAIL=${GIT_IDENTITY_EMAIL}"
    )
fi

if [ "$GIT_MODE" = true ]; then
    GIT_AGENT_SOCK="${PI_SSH_AUTH_SOCK:-${SSH_AUTH_SOCK:-}}"
    HOST_KNOWN_HOSTS="${HOME}/.ssh/known_hosts"

    if [ -z "$GIT_AGENT_SOCK" ] || [ ! -S "$GIT_AGENT_SOCK" ]; then
        echo "Error: --git needs a running SSH agent, but no agent socket was found." >&2
        echo "       Start one and load a key:  eval \"\$(ssh-agent -s)\" && ssh-add -c ~/.ssh/<key>" >&2
        echo "       Or set PI_SSH_AUTH_SOCK to the socket of a dedicated agent." >&2
        exit 1
    fi

    if [ ! -f "$HOST_KNOWN_HOSTS" ]; then
        echo "Error: --git needs ${HOST_KNOWN_HOSTS} to verify the remote's host key." >&2
        exit 1
    fi

    if [ "$UNRESTRICTED_MODE" = true ]; then
        # Host /run and the real home are already mounted at their own paths, so
        # both the socket and known_hosts are reachable unchanged. known_hosts
        # still has to be named explicitly: ssh takes the home directory from the
        # passwd entry rather than $HOME, and the uid this mode runs as is root
        # there, whose /root is the host's and unreadable.
        DOCKER_ARGS+=(
            --env "SSH_AUTH_SOCK=${GIT_AGENT_SOCK}"
            --env "GIT_SSH_COMMAND=ssh -o UserKnownHostsFile=${HOST_KNOWN_HOSTS} -o StrictHostKeyChecking=yes"
        )
    else
        DOCKER_ARGS+=(
            --mount "type=bind,src=${GIT_AGENT_SOCK},dst=/run/host-ssh-agent"
            --mount "type=bind,src=${HOST_KNOWN_HOSTS},dst=/run/host-known-hosts,readonly"
            --env "SSH_AUTH_SOCK=/run/host-ssh-agent"
            --env "GIT_SSH_COMMAND=ssh -o UserKnownHostsFile=/run/host-known-hosts -o StrictHostKeyChecking=yes"
        )
    fi
fi

if [ "$GH_MODE" = true ]; then
    # Exported rather than passed by value: --env NAME reads the variable from
    # this process, keeping the token out of the docker command line, which is
    # readable by any other process on the host.
    if [ -z "${PI_GH_TOKEN:-}" ] && command -v gh >/dev/null 2>&1; then
        PI_GH_TOKEN="$(gh auth token 2>/dev/null || true)"
    fi

    if [ -z "${PI_GH_TOKEN:-}" ]; then
        echo "Error: --gh found no token. Set PI_GH_TOKEN to a fine-grained token" >&2
        echo "       scoped to the repositories this session needs, or run gh auth login." >&2
        exit 1
    fi

    export GH_TOKEN="${PI_GH_TOKEN}"
    DOCKER_ARGS+=(--env GH_TOKEN)
fi

if [ "$UNRESTRICTED_MODE" = true ]; then
    HOST_USER_NAME="${USER:-$(id -un)}"
    HOST_GROUP_ID="$(id -g)"

    # Which uid is "you" depends on the daemon. A rootful one shares the host's
    # uid space, so run as the real uid. A rootless one maps you to container
    # uid 0 instead, and asking for your host uid there lands on an unmapped
    # subuid that owns none of the bind-mounted files: host-owned paths read as
    # another user's, writes fail, and an SSH agent socket cannot be opened.
    if [ "$ROOTLESS_DAEMON" = true ]; then
        CONTAINER_USER="0:0"
    else
        CONTAINER_USER="$(id -u):${HOST_GROUP_ID}"
    fi

    DOCKER_ARGS+=(
        --privileged
        --user "${CONTAINER_USER}"
        -e "HOME=${HOME}"
        -e "USER=${HOST_USER_NAME}"
        -e "LOGNAME=${HOST_USER_NAME}"
        -e "NPM_CONFIG_PREFIX=/pi-npm-global"
        -e "NPM_CONFIG_CACHE=/pi-npm-cache"
        -e "NODE_PATH=/opt/pi-agent/lib/node_modules:/pi-npm-global/lib/node_modules"
        -e "PATH=/opt/pi-agent/bin:/pi-npm-global/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
        -v "/:/host:rw,rslave"
        -v pi-sandbox-unrestricted-npm-global:/pi-npm-global
        -v pi-sandbox-unrestricted-npm-cache:/pi-npm-cache
    )
    # Supplementary groups only mean something when the uid space is shared; a
    # rootless namespace has no mapping for the host's gids.
    if [ "$ROOTLESS_DAEMON" != true ]; then
        for gid in $(id -G); do
            [ "$gid" = "$HOST_GROUP_ID" ] && continue
            DOCKER_ARGS+=(--group-add "$gid")
        done
    fi
    # Plain recursive binds, not rslave. Rootless Docker starts rootlesskit with
    # --copy-up=/etc --copy-up=/run, which replaces those two with private
    # overlays in the daemon's mount namespace; asking to slave them makes the
    # daemon refuse the container outright. Nothing is lost by dropping it here,
    # because /host above is bound rslave and already carries a fully
    # propagating view of the filesystem, late mounts included.
    for host_path in /etc /home /media /mnt /root /run /srv /tmp /usr /var; do
        [ -e "$host_path" ] && DOCKER_ARGS+=(-v "${host_path}:${host_path}:rw")
    done
fi

# Mount PI config directory (read-write for auth tokens and sessions)
if [ "$UNRESTRICTED_MODE" != true ] && [ -d "${PI_CONFIG_DIR}" ]; then
    DOCKER_ARGS+=(-v "${PI_CONFIG_DIR}:/home/pi/.pi/agent")
fi

# Mount skills directory (read-write, resolves host symlink)
if [ "$UNRESTRICTED_MODE" != true ] && [ -d "${PI_SKILLS_DIR}" ]; then
    DOCKER_ARGS+=(-v "${PI_SKILLS_DIR}:/home/pi/.pi/agent/skills")
fi

# Mount host-owned LifeOS resources from the adapter's private config. The
# package source stays outside the image, while runtime/skills/USER are read-only
# in the restricted sandbox. Adapter observability uses the writable Pi config
# mount instead of trying to write into the host LifeOS trees.
if [ "$UNRESTRICTED_MODE" != true ] && [ -f "$PI_LIFEOS_CONFIG_FILE" ]; then
    if command -v jq >/dev/null 2>&1; then
        for key in packageRoot runtimeRoot skillsRoot userRoot; do
            lifeos_path="$(jq -r --arg key "$key" '.[$key] // empty' "$PI_LIFEOS_CONFIG_FILE")"
            [ -n "$lifeos_path" ] || continue
            if [ -e "$lifeos_path" ]; then
                # --lifeos-write opens the personal data root only. The package,
                # runtime and skills roots are a pinned payload and stay
                # read-only in every mode, so a write cannot alter what the
                # session was told its own rules are.
                mount_mode=ro
                if [ "$LIFEOS_WRITE" = true ] && [ "$key" = userRoot ]; then
                    mount_mode=rw
                fi
                DOCKER_ARGS+=(-v "${lifeos_path}:${lifeos_path}:${mount_mode}")
            else
                echo "Warning: LifeOS ${key} path is missing: ${lifeos_path}" >&2
            fi
        done
        # Mask private subdirectories with an empty directory. The parent
        # stays readable, so a skill walking USER/ sees an empty FINANCES
        # rather than a missing path.
        if [ "$WITH_PRIVATE" != true ]; then
            lifeos_user="$(jq -r '.userRoot // empty' "$PI_LIFEOS_CONFIG_FILE")"
            if [ -n "$lifeos_user" ] && [ -d "$lifeos_user" ]; then
                mask_dir="${XDG_RUNTIME_DIR:-/tmp}/pi-sandbox-mask"
                mkdir -p "$mask_dir"
                for priv in $PI_LIFEOS_PRIVATE_DIRS; do
                    [ -d "${lifeos_user}/${priv}" ] || continue
                    DOCKER_ARGS+=(-v "${mask_dir}:${lifeos_user}/${priv}:ro")
                done
            fi
        fi
        DOCKER_ARGS+=(
            -e "PI_LIFEOS_CONFIG=/home/pi/.pi/agent/pi-lifeos.json"
            -e "PI_LIFEOS_STATE_ROOT=/home/pi/.pi/agent/lifeos-state"
        )
        # Two locks, both turned by the flag: the mount has to be writable and
        # the adapter's own mutation gate has to be open.
        if [ "$LIFEOS_WRITE" = true ]; then
            DOCKER_ARGS+=(-e "PI_LIFEOS_MEMORY_MUTATION=1")
        fi
    else
        echo "Warning: jq missing; LifeOS paths were not mounted" >&2
    fi
fi

# Mount extensions directory (read-write)
if [ "$UNRESTRICTED_MODE" != true ] && [ -d "${PI_EXTENSIONS_DIR}" ]; then
    DOCKER_ARGS+=(-v "${PI_EXTENSIONS_DIR}:/home/pi/.pi/agent/extensions")
fi

BROKER_MAPS=(--map "/workspace=${HOST_PWD}")

# Mount extra paths under /repos/<basename>
for extra in "${EXTRA_PATHS[@]}"; do
    abs_path="$(cd "$extra" && pwd)"
    if [ "$UNRESTRICTED_MODE" = true ]; then
        DOCKER_ARGS+=(-v "${abs_path}:${abs_path}")
    else
        basename="$(basename "$abs_path")"
        DOCKER_ARGS+=(-v "${abs_path}:/repos/${basename}")
        BROKER_MAPS+=(--map "/repos/${basename}=${abs_path}")
    fi
done

# Mount host tools and their dependencies into isolated /opt/host-tools/
# Binaries go to /opt/host-tools/real/<name>, libs to /opt/host-tools/lib/.
# The entrypoint creates wrapper scripts that invoke the host's dynamic linker
# with --library-path so host and container libraries never mix.
if [ -n "$TOOLS_LIST" ]; then
    declare -A LIBS_SEEN=()
    declare -A DIRS_SEEN=()
    TOOL_NAMES=()
    IFS=',' read -ra TOOLS_ARRAY <<< "$TOOLS_LIST"
    for tool in "${TOOLS_ARRAY[@]}"; do
        tool="${tool## }"; tool="${tool%% }"
        [ -z "$tool" ] && continue
        TOOL_NAMES+=("$tool")
        while IFS= read -r entry; do
            case "$entry" in
                BIN:*)
                    local_path="${entry#BIN:}"
                    DOCKER_ARGS+=(-v "${local_path}:/opt/host-tools/real/${tool}:ro")
                    ;;
                LIB:*)
                    lib_entry="${entry#LIB:}"
                    lib_needed="${lib_entry%%|*}"
                    local_path="${lib_entry#*|}"
                    [ "$lib_needed" = "$local_path" ] && lib_needed="$(basename "$local_path")"
                    # Skip glibc-family libs: exposing them to children via
                    # LD_LIBRARY_PATH would crash the container's ld-linker.
                    # The wrapper still finds them via /opt/host-tools/host-usr/lib.
                    is_glibc_lib "$lib_needed" && continue
                    if [ -z "${LIBS_SEEN[$local_path]+x}" ]; then
                        LIBS_SEEN["$local_path"]=1
                        DOCKER_ARGS+=(-v "${local_path}:/opt/host-tools/lib/${lib_needed}:ro")
                    fi
                    ;;
                DIR:*)
                    local_path="${entry#DIR:}"
                    if [ -z "${DIRS_SEEN[$local_path]+x}" ]; then
                        DIRS_SEEN["$local_path"]=1
                        DOCKER_ARGS+=(-v "${local_path}:${local_path}:ro")
                    fi
                    ;;
                SIBLING:*)
                    local_path="${entry#SIBLING:}"
                    if [ -z "${LIBS_SEEN[$local_path]+x}" ]; then
                        LIBS_SEEN["$local_path"]=1
                        # Bind-mount at the host's literal path so hardcoded
                        # execve(/usr/bin/<sibling>) calls resolve inside the
                        # container. Also pull its transitive lib deps and
                        # RPATH dirs (needed when the sibling is exec'd
                        # directly by the kernel, bypassing our wrapper).
                        DOCKER_ARGS+=(-v "${local_path}:${local_path}:ro")
                        while IFS='|' read -r sib_needed sib_lib; do
                            [ -z "$sib_lib" ] && continue
                            [ -z "$sib_needed" ] && sib_needed="$(basename "$sib_lib")"
                            if ! is_glibc_lib "$sib_needed" \
                                && [ -z "${LIBS_SEEN[$sib_lib]+x}" ]; then
                                LIBS_SEEN["$sib_lib"]=1
                                DOCKER_ARGS+=(-v "${sib_lib}:/opt/host-tools/lib/${sib_needed}:ro")
                            fi
                            sib_lib_dir="$(dirname "$sib_lib")"
                            if ! is_system_lib_dir "$sib_lib_dir" \
                                && [ -z "${DIRS_SEEN[$sib_lib_dir]+x}" ]; then
                                DIRS_SEEN["$sib_lib_dir"]=1
                                DOCKER_ARGS+=(-v "${sib_lib_dir}:${sib_lib_dir}:ro")
                            fi
                        done < <(collect_elf_libs "$local_path")
                        while IFS= read -r rp; do
                            [ -z "$rp" ] && continue
                            if [ -z "${DIRS_SEEN[$rp]+x}" ]; then
                                DIRS_SEEN["$rp"]=1
                                DOCKER_ARGS+=(-v "${rp}:${rp}:ro")
                            fi
                        done < <(collect_elf_rpaths "$local_path")
                    fi
                    ;;
            esac
        done < <(resolve_tool_deps "$tool")
    done
    # Mount host /usr read-only under /opt/host-tools/host-usr/ (excluding
    # /usr/local and /usr/src to avoid exposing user scripts with hardcoded
    # secrets). Covers dlopen'd libs, runtime data (fonts, themes, .m files,
    # configs) that ldd cannot discover. Does NOT overlay the container's own
    # /usr, so sibling binaries at hardcoded /usr/bin/<name> paths still need
    # SIBLING: detection above.
    for entry in /usr/*; do
        [ -d "$entry" ] || continue
        name="$(basename "$entry")"
        case "$name" in local|src) continue ;; esac
        DOCKER_ARGS+=(-v "${entry}:/opt/host-tools/host-usr/${name}:ro")
    done
    # Writable tmpfs for wrapper scripts created by entrypoint
    DOCKER_ARGS+=(--tmpfs /opt/host-tools/bin:rw,exec,nosuid,size=1m,uid=1000,gid=1000)
    # Tell entrypoint which tools to wrap
    DOCKER_ARGS+=(-e "PI_HOST_TOOLS=$(IFS=,; echo "${TOOL_NAMES[*]}")")
fi

# --host-apps mode: bind-mount host /usr subdirs over the container's /usr so
# every host-installed binary works natively. No wrappers, no lib isolation.
# /usr/local and /usr/src are excluded to keep user scripts (which may embed
# secrets) out of the container. The container's pi agent lives at
# /opt/pi-agent (outside /usr), so it survives the overlay.
if [ "$HOST_APPS_MODE" = true ]; then
    for sub in bin sbin lib lib32 lib64 libexec share include; do
        [ -d "/usr/${sub}" ] && \
            DOCKER_ARGS+=(-v "/usr/${sub}:/usr/${sub}:ro")
    done
fi

# Security hardening (applied in all modes except login)
if [ "$LOGIN_MODE" != true ] && [ "$UNRESTRICTED_MODE" != true ]; then
    DOCKER_ARGS+=(
        --cap-drop=ALL
        --security-opt=no-new-privileges
        --read-only
        --tmpfs /tmp:rw,noexec,nosuid,size=256m
        -v pi-sandbox-npm-global:/home/pi/.npm-global
        -v pi-sandbox-npm-cache:/home/pi/.npm
        --tmpfs /home/pi/.cache:rw,nosuid,size=256m,uid=1000,gid=1000
        # A read-only HOME makes tools that persist state on exit fail there;
        # octave reports an execution_exception and returns 0 having worked.
        --tmpfs /home/pi/.config:rw,nosuid,size=64m,uid=1000,gid=1000
        --tmpfs /home/pi/.local:rw,nosuid,size=64m,uid=1000,gid=1000
    )
fi

# Rootless Docker maps the invoking user to container uid 0, so the image's
# own "pi" user (uid 1000) owns none of the bind-mounted host files and cannot
# write the workspace. Run as uid 0, which IS this user outside the namespace.
if [ "$ROOTLESS_DAEMON" = true ] && [ "$UNRESTRICTED_MODE" != true ]; then
    DOCKER_ARGS+=(--user 0:0)
fi

# Network mode
if [ "$LOGIN_MODE" = true ] || [ "$LOCAL_MODE" = true ] || [ "$UNRESTRICTED_MODE" = true ]; then
    # Host network: needed for OAuth callbacks or local LLM access
    DOCKER_ARGS+=(--network host -e PI_HOST_NETWORK=1)
else
    # Bridge network with host.docker.internal
    DOCKER_ARGS+=(--add-host=host.docker.internal:host-gateway)
fi

# --fpga: the broker lives exactly as long as this session. It is told the
# container->host path map, so it refuses any directory not mounted here.
if [ "$FPGA_MODE" = true ]; then
    SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
    BROKER_CONFIG="${PI_BROKER_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/pi-sandbox/broker.json}"
    BROKER_LOG="${XDG_STATE_HOME:-$HOME/.local/state}/pi-sandbox/broker.log"
    if ! command -v bun >/dev/null; then
        echo "Error: --fpga needs bun on the host to run the broker." >&2
        exit 1
    fi
    if [ ! -f "$BROKER_CONFIG" ]; then
        echo "Error: --fpga needs a broker config at $BROKER_CONFIG (see broker/README.md)." >&2
        exit 1
    fi
    mkdir -p "$(dirname "$BROKER_LOG")"
    BROKER_DIR="$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/pi-broker.XXXXXX")"
    chmod 700 "$BROKER_DIR"
    bun "$SCRIPT_DIR/broker/broker.ts" --socket "$BROKER_DIR/broker.sock" \
        --config "$BROKER_CONFIG" --parent $$ "${BROKER_MAPS[@]}" 2>>"$BROKER_LOG" &
    BROKER_PID=$!
    trap 'kill "$BROKER_PID" 2>/dev/null; rm -rf "$BROKER_DIR"' EXIT
    for _ in $(seq 50); do
        [ -S "$BROKER_DIR/broker.sock" ] && break
        kill -0 "$BROKER_PID" 2>/dev/null || break
        sleep 0.1
    done
    if [ ! -S "$BROKER_DIR/broker.sock" ]; then
        echo "Error: the FPGA broker did not start; see $BROKER_LOG" >&2
        tail -n 5 "$BROKER_LOG" >&2
        exit 1
    fi
    DOCKER_ARGS+=(
        -v "$BROKER_DIR:/run/pi-broker"
        -v "$SCRIPT_DIR/broker/fpga-run.ts:/usr/local/bin/fpga-run:ro"
        -e "PI_BROKER_SOCK=/run/pi-broker/broker.sock"
    )
fi

DOCKER_ARGS+=("${IMAGE_NAME}")

# Append any PI arguments
if [ ${#PI_ARGS[@]} -gt 0 ]; then
    DOCKER_ARGS+=("${PI_ARGS[@]}")
fi

if [ "$FPGA_MODE" != true ]; then
    exec "${DOCKER_ARGS[@]}"
fi
# Not exec'd, so the EXIT trap can stop the broker when the session ends.
set +e
"${DOCKER_ARGS[@]}"
exit $?
